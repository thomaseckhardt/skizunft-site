PUBLIC_ENV="development"
# Storyblok Space
# Skizunft
STORYBLOK_SPACE=""
# Storyblok Authentication
# https://www.storyblok.com/docs/api/content-delivery/v2#topics/introduction  
# Get Storyblok access token for the specific environment here
# https://app.storyblok.com/#/me/spaces/256004/settings?tab=api
STORYBLOK_TOKEN=""
STORYBLOK_MANAGEMENT_TOKEN=""
# Storyblok version of the entry
# draft | published
STORYBLOK_VERSION="draft"
# Email
NETLIFY_EMAILS_PROVIDER=""
NETLIFY_EMAILS_SECRET=""
PUBLIC_BOOKING_ENABLED="true"

BREVO_API_KEY=""

# Shared secret of the server-side callers of the Convex booking functions.
# Set the same value in Convex (`npx convex env set ADMIN_API_SECRET`).
ADMIN_API_SECRET=""

# Local admin area (`pnpm admin`) only. Put these into .env.admin.local
# together with ADMIN_API_SECRET and BREVO_API_KEY of the production setup.
# ADMIN_CONVEX_URL="https://<deployment>.convex.cloud"

# UPDATE GOOGLE SERVICE ACCOUNT DETAILS
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_ID=""