---
import type { MeetingPoint } from '@/data/meeting-points'

type Props = {
  points: MeetingPoint[]
  label: string
  /** Zoom levels added to the zoom that fits all points, e.g. -1 to zoom out. */
  zoomOffset?: number
}

const { points, label, zoomOffset = 0 } = Astro.props
---

<figure>
  <div
    class='relative aspect-[4/3] min-h-[400px] max-w-full overflow-hidden rounded bg-slate-100'
  >
    <div
      class='absolute inset-0'
      role='region'
      aria-label={label}
      data-meeting-point-map={JSON.stringify(points)}
      data-zoom-offset={zoomOffset}
    >
    </div>
    <div
      class='absolute inset-0 hidden items-center justify-center p-6 text-center text-sm text-gray-600'
      data-meeting-point-map-fallback
    >
      Die Karte ist derzeit nicht verfügbar. Nutze den Link „Route auf Google Maps
      anzeigen“ beim jeweiligen Treffpunkt.
    </div>
    <div
      class='absolute inset-0 hidden flex-col items-center justify-center gap-4 p-6 text-center text-sm text-gray-600'
      data-meeting-point-map-consent
    >
      <p class='max-w-sm'>
        Die Karte wird von MapTiler geladen. Dabei wird deine IP-Adresse an
        MapTiler übertragen. Mehr dazu in unserer <a
          class='link'
          href='/datenschutz'>Datenschutzerklärung</a
        >.
      </p>
      <button
        type='button'
        class='rounded-full bg-brandred-600 px-4 py-1.5 font-semibold text-white shadow-md transition ease-in-out hover:bg-brandred-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brandred-600'
        data-meeting-point-map-accept
      >
        Karte laden
      </button>
    </div>
    <noscript>
      <div
        class='absolute inset-0 flex items-center justify-center p-6 text-center text-sm text-gray-600'
      >
        Für die Karte wird JavaScript benötigt. Nutze den Link „Route auf Google
        Maps anzeigen“ beim jeweiligen Treffpunkt.
      </div>
    </noscript>
  </div>
  <figcaption class='mt-3 hidden text-sm leading-snug'>
    Klicke auf die Markierungen für weitere Informationen und die Route zu den
    Treffpunkten.
  </figcaption>
</figure>

<script>
  import {
    acceptConsent,
    consentReady,
    hasConsent,
  } from '@/components/consent/cookieConsent'
  import {
    googleMapsRouteUrl,
    type MeetingPoint,
  } from '@/data/meeting-points'

  const apiKey = import.meta.env.PUBLIC_MAPTILER_KEY as string | undefined

  // German UI strings of the MapLibre controls used on this map.
  const locale = {
    'AttributionControl.ToggleAttribution': 'Quellenangaben ein-/ausblenden',
    'CooperativeGesturesHandler.WindowsHelpText':
      'Strg + Scrollen zum Zoomen der Karte',
    'CooperativeGesturesHandler.MacHelpText':
      '⌘ + Scrollen zum Zoomen der Karte',
    'CooperativeGesturesHandler.MobileHelpText':
      'Karte mit zwei Fingern verschieben',
    'Marker.Title': 'Kartenmarkierung',
    'NavigationControl.ZoomIn': 'Hineinzoomen',
    'NavigationControl.ZoomOut': 'Herauszoomen',
    'Popup.Close': 'Schließen',
  }

  const showFallback = (container: HTMLElement) => {
    container.hidden = true
    const fallback = container.parentElement?.querySelector<HTMLElement>(
      '[data-meeting-point-map-fallback]',
    )
    fallback?.classList.replace('hidden', 'flex')
  }

  const createMarkerElement = (point: MeetingPoint) => {
    const element = document.createElement('div')
    element.className =
      'flex size-8 cursor-pointer items-center justify-center rounded-full border-2 border-white bg-brandred-600 text-sm font-bold text-white shadow-md'
    element.setAttribute('aria-label', point.title)
    if (point.label) {
      element.textContent = point.label
    } else {
      const dot = document.createElement('span')
      dot.className = 'size-2.5 rounded-full bg-white'
      element.append(dot)
    }
    return element
  }

  const createPopupContent = (point: MeetingPoint) => {
    const content = document.createElement('div')
    content.className = 'space-y-1 pr-4 text-sm leading-snug'

    const title = document.createElement('p')
    title.className = 'font-bold'
    title.textContent = point.title

    const description = document.createElement('p')
    description.textContent = point.description

    const link = document.createElement('a')
    link.className = 'link block pt-1'
    link.href = googleMapsRouteUrl(point)
    link.target = '_blank'
    link.rel = 'noopener noreferrer'
    link.textContent = 'Route auf Google Maps anzeigen'

    content.append(title, description, link)
    return content
  }

  const initMap = async (container: HTMLElement) => {
    const points: MeetingPoint[] = JSON.parse(
      container.dataset.meetingPointMap ?? '[]',
    )
    const zoomOffset = Number(container.dataset.zoomOffset ?? 0)
    if (!apiKey || points.length === 0) {
      showFallback(container)
      return
    }

    try {
      const [sdk] = await Promise.all([
        import('@maptiler/sdk'),
        import('@maptiler/sdk/dist/maptiler-sdk.css'),
      ])
      const {
        config,
        Language,
        LngLatBounds,
        Map,
        MapStyle,
        Marker,
        NavigationControl,
        Popup,
      } = sdk

      // The EU endpoints (config.useEuEndpoints) require a paid plan.
      config.apiKey = apiKey
      config.telemetry = false
      config.caching = false

      const bounds = new LngLatBounds()
      points.forEach(({ lng, lat }) => bounds.extend([lng, lat]))

      const map = new Map({
        container,
        style: MapStyle.WINTER_V4,
        language: Language.GERMAN,
        center: bounds.getCenter(),
        zoom: 16,
        cooperativeGestures: true,
        dragRotate: false,
        pitchWithRotate: false,
        touchPitch: false,
        navigationControl: false,
        geolocateControl: false,
        terrainControl: false,
        // Globe effects only; with the style's halo the SDK emits an error
        // event for a layer it tries to remove before adding it.
        halo: false,
        space: false,
        locale,
      })
      map.addControl(new NavigationControl({ showCompass: false }))
      map.touchZoomRotate.disableRotation()

      if (points.length > 1) {
        map.fitBounds(bounds, { padding: 96, maxZoom: 16, duration: 0 })
      }
      if (zoomOffset) {
        map.setZoom(map.getZoom() + zoomOffset)
      }

      points.forEach((point) => {
        new Marker({ element: createMarkerElement(point) })
          .setLngLat([point.lng, point.lat])
          .setPopup(
            new Popup({ offset: 20, maxWidth: '260px' }).setDOMContent(
              createPopupContent(point),
            ),
          )
          .addTo(map)
      })

      // An exhausted quota or a rejected key fails with an HTTP error before
      // the style loads. Other error events are not fatal and only logged.
      // The SDK retries with its default style on its own, so the map is
      // only hidden here; removing it mid-retry throws inside the SDK.
      let loaded = false
      let failed = false
      map.once('load', () => {
        if (failed) return
        loaded = true
        // The caption only makes sense once the markers are on screen.
        container
          .closest('figure')
          ?.querySelector('figcaption')
          ?.classList.remove('hidden')
      })
      map.on('error', (event) => {
        console.error('[MeetingPointMap]', event.error)
        const status = (event.error as { status?: number } | undefined)?.status
        // A 404 only means a missing tile, the map itself still works.
        if (!loaded && !failed && status !== undefined && status !== 404) {
          failed = true
          showFallback(container)
        }
      })
    } catch (error) {
      console.error('[MeetingPointMap]', error)
      showFallback(container)
    }
  }

  // Loading the SDK starts a billed MapTiler session, so maps are only
  // created once they come close to the viewport.
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return
        observer.unobserve(entry.target)
        initMap(entry.target as HTMLElement)
      })
    },
    { rootMargin: '200px' },
  )

  const containers = document.querySelectorAll<HTMLElement>(
    '[data-meeting-point-map]',
  )

  const consentPlaceholder = (container: HTMLElement) =>
    container.parentElement?.querySelector<HTMLElement>(
      '[data-meeting-point-map-consent]',
    )

  // MapTiler receives the visitor's IP address, so maps only load with
  // consent. Until then a placeholder asks for it.
  let started = false
  const startMaps = () => {
    if (started || !hasConsent('maps')) return
    started = true
    containers.forEach((container) => {
      consentPlaceholder(container)?.classList.replace('flex', 'hidden')
      observer.observe(container)
    })
  }

  consentReady.then(() => {
    if (hasConsent('maps')) {
      startMaps()
      return
    }
    containers.forEach((container) => {
      const placeholder = consentPlaceholder(container)
      placeholder?.classList.replace('hidden', 'flex')
      placeholder
        ?.querySelector('[data-meeting-point-map-accept]')
        ?.addEventListener('click', () => acceptConsent('maps'))
    })
    // Consent given in the banner or the preferences while on the page
    window.addEventListener('cc:onConsent', startMaps)
    window.addEventListener('cc:onChange', startMaps)
  })
</script>
