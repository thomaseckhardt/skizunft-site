---
import Icon from '@/components/Icon.astro'
import Status_20260128_1600 from '@/components/skischool/Status_20260128_1600.astro'
import Status_20251226_1305 from '@/components/skischool/Status_20251226_1305.astro'
import {
  courseBambini,
  courseBeginner,
  courseChampion,
  courseJuniorChampion,
} from '@/data/course-info'
import clsx from 'clsx'

const { class: className } = Astro.props

const courses = [
  courseBambini,
  courseBeginner,
  courseJuniorChampion,
  courseChampion,
]

const SHOW_STATUS = false
---

{
  SHOW_STATUS && (
    <div class={clsx('box', className)}>
      <div class='mx-auto max-w-2xl'>
        <h2>
          <div class='typo-hero text-left'>Findet mein Kurs statt?</div>
        </h2>
        <p class='mt-4 flex items-center gap-x-1 text-xs leading-tight text-sky-600 md:text-sm'>
          <Icon name='arrow-sync-circle-16-regular' />
          <span>Aktualisiert am 28.01.2026 um 16:00 Uhr</span>
        </p>
      </div>
      <div class='mx-auto mt-16 max-w-2xl space-y-16'>
        <Status_20260128_1600 />
        <Status_20251226_1305 />
      </div>
    </div>
  )
}
