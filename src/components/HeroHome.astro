---
import { Image } from 'astro:assets'

import HeroHomeImage from '../images/hero-skikurse.png'
import EventCard from './EventCard.astro'
import { fetchStories, getQueryDate, parseDate } from '@/storyblok/utils'
import { loadBookingData } from '@/data/booking'
import { getToday } from './skischool/courseSchedule'
import { getCourseWeekends } from './skischool/courseWeekends'
import clsx from 'clsx'

const maxEvents = 4

const today = getQueryDate(new Date())

const eventStories = await fetchStories({
  content_type: 'Event',
  per_page: maxEvents,
  sort_by: 'content.date:asc',
  filter_query: {
    date: {
      gt_date: today,
    },
  },
})
const storyEvents = eventStories.map((story) => ({
  ...story.content,
  _key: story.uuid,
  href: story.content.link?.url,
  date: parseDate(story.content.date),
}))

const toDateString = (date: Date) => date.toISOString().slice(0, 10)

const { courses } = await loadBookingData()
const courseWeekendEvents = getCourseWeekends(
  courses
    .filter((course: any) => course.catgeory?.slug)
    .map((course: any) => ({
      slug: course.slug,
      categorySlug: course.catgeory.slug,
      categoryName: course.catgeory.name,
      startDate: toDateString(course.startDate),
      endDate: toDateString(course.endDate),
      canceled: course.canceled,
    })),
  getToday(),
).map((weekend) => ({
  _key: weekend.key,
  href: '/skischule/kurse',
  title: weekend.title,
  description: weekend.description,
  date: parseDate(`${weekend.startDate} 00:00`),
}))

const events = [...storyEvents, ...courseWeekendEvents]
  .sort((a, b) => a.date.getTime() - b.date.getTime())
  .slice(0, maxEvents)
---

<div class="relative mx-auto flex max-w-[1600px] flex-col lg:block">
  {
    events.length > 0 && (
      <div class="mb:box order-1 max-w-full">
        <div class="relative py-10 lg:py-0">
          <div class="px-6 font-hero text-xl leading-tight text-brandblue-600 lg:hidden">
            Unsere nächsten Veranstaltungen
          </div>
          <div class="scrollbar-hidden flex max-w-full items-stretch gap-x-2 gap-y-4 overflow-auto px-6 pb-4 pt-2 lg:absolute lg:right-0 lg:top-0 lg:flex-col lg:overflow-visible lg:pb-0 lg:pt-0">
            <div class="hidden font-hero text-xl leading-tight text-brandblue-600 lg:block relative z-10">
              Unsere nächsten Veranstaltungen
            </div>
            {events.map((event) => (
              <EventCard
                key={event._key}
                href={event.href}
                className="relative z-10 flex-none max-w-80"
                {...event}
              />
            ))}
          </div>
        </div>
      </div>
    )
  }
  <div class={clsx("h-[400px] lg:h-[600px]")}>
    <Image
      src={HeroHomeImage}
      alt="Skikurse für Kinder und Erwachsene"
      class="h-full w-full max-w-none object-cover"
    />
    <a href="/buchung" class="absolute inset-0">
      <span class="sr-only">Ski- oder Snowboard Kurs buchen</span>
    </a>
  </div>
  <!-- <img
      src={DsvSkischule.src}
      alt="DSV Skischule Skizunft Kollnau e.V."
      class="absolute bottom-0 left-0 w-auto h-[24px]"
    /> -->
</div>
