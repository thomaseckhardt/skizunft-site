---
import MeetingPointMap from '@/components/MeetingPointMap.astro'
import MeetingPointRouteLink from '@/components/MeetingPointRouteLink.astro'
import Image from '@/components/shared/Image.astro'
import {
  kandelMeetingPoints,
  muggenbrunnMeetingPoints,
} from '@/data/meeting-points'
import Page from '@/layouts/Page.astro'

const [kandelhof, parkplatz] = kandelMeetingPoints
const [harryhirsch] = muggenbrunnMeetingPoints
---

<Page title='Treffpunkte für Skikurse und Snowboardkurse' description=''>
  <main class='box'>
    <h2>
      <div class='typo-overline'>Hier finden unsere Kurse statt</div>
      <div class='typo-hero'>Skigebiete und Treffpunkte</div>
    </h2>
    <div class='prose mx-auto mt-8 flow-root max-w-3xl md:mt-12'>
      <p>
        Wenn immer möglich, finden unsere Kurse auf dem Kandel statt. Sollte der
        Schnee mal nicht reichen, versuchen wir in andere Skigebiete im
        Schwarzwald auszuweichen. Mögliche Alternativen sind zum Beispiel
        Muggenbrunn und der Feldberg.
      </p>
    </div>
    <div class='mx-auto mt-8 flow-root max-w-3xl space-y-12 md:mt-16'>
      <div>
        <h3 id='kandel'>
          <div class='typo-hero'>Kandel</div>
        </h3>
      </div>
      <div>
        <h4>
          <div class='typo-hero-xs'>Treffpunkt 1: Berggasthaus Kandelhof</div>
        </h4>
        <MeetingPointRouteLink point={kandelhof} />
        <div class='prose mt-3'>
          <p>
            Unser Schild „DSV-Skischule Kandel Skizunft Kollnau“ am Berggasthaus
            Kandelhof. Hier treffen sich alle Teilnehmer unserer <b
              >Junior Champion</b
            > und <b>Champion Skikurse</b>, sowie alle <b>Snowboard</b> Kurse.
          </p>
        </div>
      </div>
      <div>
        <h4>
          <div class='typo-hero-xs'>Treffpunkt 2: Parkplatz</div>
        </h4>
        <MeetingPointRouteLink point={parkplatz} />
        <div class='prose mt-3'>
          <p>
            Der Parkplatz vor dem Wald in Richtung St. Peter. Hier treffen sich
            alle Teilnehmer unserer <b>Bambini</b> und <b>Beginner Skikurse</b>.
          </p>
        </div>
      </div>
      <MeetingPointMap
        points={kandelMeetingPoints}
        label='Karte der Treffpunkte am Kandel'
        zoomOffset={-1}
      />
    </div>
    <div class='mx-auto mt-8 flow-root max-w-3xl space-y-12 md:mt-16'>
      <div>
        <h3 id='muggenbrunn'>
          <div class='typo-hero'>Muggenbrunn</div>
        </h3>
      </div>
      <div>
        <h4>
          <div class='typo-hero-xs'>
            Treffpunkt: Harryhirsch Kiosk Hütte an der Talstation
          </div>
        </h4>
        <MeetingPointRouteLink point={harryhirsch} />
        <div class='prose mt-3'>
          <p>
            Alle Kursteilnehmer treffen sich am <a
              href='https://www.skizentrum-muggenbrunn.de/gastronomie/'
              target='_blank'
              rel='noreferer'>Harryhirsch Kiosk</a
            > an der Talstation Wasenlift in Muggenbrunn. Haltet ausschau nach unserer
            weißen Beachflagge mit dem Skizunft Logo und einem Pinguin.
            <a
              href='https://www.skizentrum-muggenbrunn.de/preise/'
              target='_blank'
              rel='noreferer'
            >
              Liftkarten für das Skigebiet
            </a> können online gekauft werden.
          </p>
        </div>
      </div>
      <div>
        <Image
          src='https://a.storyblok.com/f/256004/3590x2392/787bc6ca4b/skizunft-kollnau-treffpunkt-muggenbrunn-harryhirsch.jpg'
          width={768}
          height={512}
          alt=''
          class='rounded'
        />
      </div>
      <MeetingPointMap
        points={muggenbrunnMeetingPoints}
        label='Karte des Treffpunkts in Muggenbrunn'
      />
    </div>
  </main>
</Page>
